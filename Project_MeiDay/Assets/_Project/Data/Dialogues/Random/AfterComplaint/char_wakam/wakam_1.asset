  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: wakam_1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC9C1\uC6D0\uACFC \uBBFC\uC6D0\uC778\uB4E4"
    text: "\uAE84\uC57C\uC57D!!"
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uAC11\uC790\uAE30 \uB3D9\uC0AC\uBB34\uC18C \uC804\uCCB4\uAC00 \uD63C\uB780\uC2A4\uB7EC\uC6CC\uC84C\uB2E4."
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 0}
    speakerName: "\uB09C\uB3D9\uAFBC?"
    text: "\uC5B4\uC774\uC5B4\uC774 \uBE44\uCF1C!"
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uB09C\uB3D9\uAFBC?"
    text: "\uC800\uAE30 \uC9C1\uC6D0\uC528! \uB098 \uC880 \uB3C4\uC640\uC918. \uB098
      \uC9C4\uC9DC \uC774\uC0C1\uD55C \uC0AC\uB78C \uC544\uB2C8\uB77C\uB2C8\uAE4C!!"
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: 
    text: "\uC544\uB9C8\uB3C4? \uB098\uCCB4\uB85C \uBCF4\uC774\uB294 \uB0A8\uC790\uAC00
      \uC228\uC744 \uD5D0\uB5A1\uC774\uBA70 \uC0AC\uB78C\uB4E4\uC744 \uBC00\uCE58\uBA70
      \uB4E4\uC5B4\uC654\uB2E4."
    choices:
    - choiceText: "\uC5B4.. \uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    nextLineIndex: 5
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uC640\uCE74\uBAA8"
    text: "\uB09C \uC640\uCE74\uBAA8\uB77C\uACE0 \uD574. \uC798 \uB4E4\uC5B4\uBD10.
      \uC6B0\uB9AC \uC9C0\uC5ED\uC740 \uC18C\uD589\uC131\uAD70\uC774\uC57C. \uADF8\uB798\uC11C
      \uBB50 \uD558\uB098 \uB9CC\uB4E4 \uB54C\uB3C4 \uB418\uAC8C \uC870\uC2EC\uD788
      \uD574\uC57C \uD55C\uB2E8 \uB9D0\uC774\uC57C. \uD3C9\uC18C\uC5D0\uB294 \uC8FC\uBBFC\uB4E4\uC774
      \uB3D9\uC758\uD558\uBA74 \uC870\uAE08\uC529 \uBC14\uAFD4\uAC00\uBA74\uC11C
      \uC0B4\uC558\uC5B4."
    choices: []
    nextLineIndex: 6
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uC640\uCE74\uBAA8"
    text: "\uBB38\uC81C\uB294 \uC774\uBC88 \uB3C4\uB85C \uACF5\uC0AC\uC57C. \uAC74\uC124\uC0AC
      \uB140\uC11D\uB4E4\uC774 \uADF8\uB0E5 \uC640\uC11C\uB294, \uB3C4\uB85C\uB97C
      \uD655\uC7A5\uC2DC\uD0A4\uACA0\uB2E4 \uD588\uC9C0. \uB098\uB3C4 \uCC98\uC74C\uC5D4
      \uC88B\uC558\uC5B4! \uADF8\uB7EC\uBA74 \uC0AC\uB294 \uAC83\uB3C4 \uD3B8\uD574\uC9C0\uB2C8\uAE4C."
    choices: []
    nextLineIndex: 7
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uC640\uCE74\uBAA8"
    text: "\uACF5\uC0AC\uAC00 \uC2DC\uC791\uD558\uB2C8\uAE4C, \uC9D1 \uBA87 \uAC1C\uAC00
      \uCCA0\uAC70\uB418\uB354\uB77C\uACE0. \uBB50 \uD3C9\uC18C \uC788\uB294 \uC77C\uC774\uACE0,
      \uC11C\uB85C \uC774\uC0AC \uD558\uB294 \uAC83\uB3C4 \uB3C4\uC6B0\uB2C8\uAE4C
      \uB098\uB294 \uADF8\uAC70\uB098 \uCC3D\uBB38\uC73C\uB85C \uAD6C\uACBD\uD558\uACE0
      \uC788\uC5C8\uC9C0!"
    choices: []
    nextLineIndex: 8
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uC640\uCE74\uBAA8"
    text: "\uADFC\uB370 \uAC11\uC790\uAE30 \uCC9C\uC7A5\uC774 \uCF70\uACFC\uAD11-!!
      \uD558\uB354\uB2C8, \uAE00\uC384 \uCC9C\uC7A5\uC774 \uB72F\uACBC\uB2E4\uB2C8\uAE4C!!
      \uC54C\uACE0\uBCF4\uB2C8 \uAC74\uC124\uC0AC \uB188\uB4E4\uC774, \uC0AC\uB78C\uB4E4
      \uC758\uC0AC\uB294 \uBB34\uC2DC\uD558\uACE0 \uCCA0\uAC70\uD558\uB294 \uAC70\uC57C!"
    choices: []
    nextLineIndex: 9
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uC640\uCE74\uBAA8"
    text: "\uC2EC\uC9C0\uC5B4 \uC9D1\uC5D0\uB294 \uB0B4\uAC00 \uC788\uC5C8\uB294\uB370!
      \uADF8\uB798\uC11C \uB098\uB3C4 \uC774\uB807\uAC8C \uC0B4\uB824\uACE0 \uB3C4\uB9DD\uCCD0
      \uC654\uB2E4\uB2C8\uAE4C!! \uADF8\uB798\uC11C \uC9C1\uC6D0\uC528. \uB098 \uC880
      \uB3C4\uC640\uC8FC\uBA74 \uC548\uB3FC? \uB098 \uC9C4\uC9DC \uC788\uC744 \uACF3\uB3C4
      \uC5C6\uB2E8 \uB9D0\uC774\uC57C.."
    choices:
    - choiceText: "(\uBA54\uB274\uC5BC \uB300\uB85C \uC784\uC2DC \uC8FC\uAC70\uC9C0\uB97C
        \uC548\uB0B4\uD55C\uB2E4.)"
      nextLineIndex: 10
      eventId: 0
      eventValue: 0
    - choiceText: "\uC5B4.. \uC800\uD76C\uAC00 \uBC94\uC8C4 \uC2E0\uACE0\uB3C4 \uB3D5\uAE34
        \uD558\uB294\uB370.."
      nextLineIndex: 10
      eventId: 0
      eventValue: 0
    nextLineIndex: 8
  - speakerFace: {fileID: -1390241267255581330, guid: 3185eff40c40e5344ae993bc08ad7a79, type: 3}
    speakerName: "\uC640\uCE74\uBAA8"
    text: "\uC815\uB9D0?! \uB098 \uB3C4\uC640\uC8FC\uB294 \uAC70\uC57C? \uC815\uB9D0
      \uACE0\uB9C8\uC6CC! \uC774 \uC740\uD61C\uB294 \uAF2D \uAC1A\uC744\uAC8C!"
    choices: []
    nextLineIndex: 11
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uADF8\uB294 \uAE30\uC05C \uD45C\uC815\uC73C\uB85C \uBCF4\uC548\uACFC
      \uC9C1\uC6D0\uB4E4\uC5D0\uAC8C \uB04C\uB824 \uB098\uAC14\uB2E4."
    choices: []
    nextLineIndex: -1
