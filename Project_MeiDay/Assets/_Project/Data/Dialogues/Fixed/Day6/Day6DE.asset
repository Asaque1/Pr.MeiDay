  - speakerFace: {fileID: 2753569924654001648, guid: 440cfff5952468c4d80f8fae4fdf94f8, type: 3}
    speakerName: "\uADDC\uADDC"
    text: "\uC774\uC81C\uC57C \uB9D0\uB85C \uC804\uBD80 \uAC00\uC838\uC654\uC2B5\uB2C8\uB2E4."
    choices:
    - choiceText: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC804\uBD80 \uCC59\uACA8\uC624\uC168\uB124\uC694!"
      nextLineIndex: 2
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 2753569924654001648, guid: 440cfff5952468c4d80f8fae4fdf94f8, type: 3}
    speakerName: "\uADDC\uADDC"
    text: "AI\uD55C\uD14C \uBB3C\uC5B4\uBCF4\uBA74\uC11C\uAE4C\uC9C0 \uB2E4 \uD655\uC778\uD588\uC8E0
      \uC81C\uAC00."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 2753569924654001648, guid: 440cfff5952468c4d80f8fae4fdf94f8, type: 3}
    speakerName: "\uADDC\uADDC"
    text: "\uC544, \uADF8\uB9AC\uACE0 \uC800\uD76C \uAC00\uAC8C \uC624\uC2DC\uBA74
      \uD2B9\uBCC4\uD788 \uB354 \uC2F8\uAC8C \uD574\uB4DC\uB9B4\uAC8C\uC694. \uB355\uBD84\uC5D0
      \uC798 \uB410\uC796\uC544\uC694."
    choices:
    - choiceText: "\uC5D0\uC774 \uC548 \uADF8\uB7EC\uC154\uB3C4 \uB418\uB294\uB370."
      nextLineIndex: 4
      eventId: 0
      eventValue: 0
    - choiceText: "\uC815\uB9D0\uC694? \uC815\uB9D0 \uAC10\uC0AC\uD574\uC694."
      nextLineIndex: 4
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 2753569924654001648, guid: 440cfff5952468c4d80f8fae4fdf94f8, type: 3}
    speakerName: "\uADDC\uADDC"
    text: "\uADF8\uB7EC\uBA74 \uC800\uD76C \uAC00\uAC8C \uC88C\uD45C \uBCF4\uB0B4\uB4DC\uB9B4\uD14C\uB2C8\uAE4C
      \uC790\uC8FC \uB4E4\uB824\uC8FC\uC138\uC694."
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uADDC\uADDC\uC528\uC758 \uC0AC\uBB34\uC6A9\uD488\uC810\uC758 \uC88C\uD45C\uB97C
