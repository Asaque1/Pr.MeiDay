  m_Name: SnitchStory
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC800.. \uC544\uBB34\uB798\uB3C4 \uBABB\uD558\uACA0\uC5B4\uC694."
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uBB50\uB77C\uACE0?"
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "USB. \uBABB \uB3C4\uC640\uB4DC\uB9B4 \uAC70 \uAC19\uC544\uC694."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uB108, \uADF8\uAC8C \uBB34\uC2A8 \uB73B\uC778\uC9C0\uB294 \uC54C\uC9C0?"
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uB124. \uC624\uB298\uC740 \uBABB \uB4E4\uC740 \uAC78\uB85C \uD560\uAC8C\uC694.
      \uC774\uB9CC \uB4E4\uC5B4\uAC00\uACA0\uC2B5\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uBC16\uC73C\uB85C \uB098\uC640 \uD55C\uCC38\uC744 \uAC77\uB294\uB2E4."
    choices: []
    nextLineIndex: 6
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uD558.. \uB0B4\uAC00 \uC65C \uADF8\uB7AC\uC9C0??"
    choices: []
    nextLineIndex: 7
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uC774\uB7EC\uBA74 \uB354\uC774\uC0C1 \uB3C4\uB9DD\uCE60 \uC218 \uC788\uB294
      \uACF3\uB3C4 \uC5C6\uC796\uC544. \uAC8C\uB2E4\uAC00 \uC800 \uC0AC\uB78C\uC774
      \uC774\uC81C \uB0B4 \uC2E0\uBD84\uC744 \uC2E0\uACE0\uD560 \uC218\uB3C4 \uC788\uACE0..)"
    choices:
    - choiceText: "\uC88B\uC740 \uC0DD\uAC01\uC774 \uB0AC\uC5B4."
      nextLineIndex: 8
      eventId: 0
      eventValue: 0
    nextLineIndex: 8
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC870\uC6A9\uD788 PDA\uB97C \uD1B5\uD574 \uC804\uD654\uB97C \uAC74\uB2E4."
    choices: []
    nextLineIndex: 9
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uD55C\uBC88..."
    choices: []
    nextLineIndex: 10
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uB450\uBC88.."
    choices: []
    nextLineIndex: 11
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC2E0\uD638\uC74C\uC774 \uB4E4\uB9B4 \uB54C\uB9C8\uB2E4 \uC2EC\uC7A5\uC774
      \uB0B4\uB824\uC549\uB294 \uAE30\uBD84\uC774\uB2E4. \uD558\uC9C0\uB9CC \uD574\uC57C
      \uD55C\uB2E4. \uB098\uB97C \uC704\uD574\uC11C\uB77C\uB3C4."
    choices: []
    nextLineIndex: 12
  - speakerFace: {fileID: 0}
    speakerName: ???
    text: "\uC5EC\uBCF4\uC138\uC694? \uC8C4\uC1A1\uD569\uB2C8\uB2E4\uB9CC \uC9C0\uAE08\uC740
      \uD1B5\uD654\uB97C \uBC1B\uC744\uB9CC\uD55C \uC0C1\uD669\uC774 \uC544\uB2C8\uB77C.."
    choices: []
    nextLineIndex: 12
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uB0D0\uBB38\uC528. \uC800 \uAE30\uC5B5\uD558\uC2DC\uB098\uC694? \uBBFC\uC6D0\uCC98\uB9AC\uACFC
      \uC2E0\uC785\uC785\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 13
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uADF8\uB798\uC694. \uAE30\uC5B5\uB0A9\uB2C8\uB2E4. \uBB34\uC2A8 \uC77C\uC778\uAC00\uC694?"
    choices:
    - choiceText: "\uC815\uAC70\uC7A5\uC758 \uBC00\uC218\uC640 \uBC94\uC8C4\uC870\uC9C1\uC5D0
        \uB300\uD574 \uB9D0\uD560 \uAC8C \uC788\uC5B4\uC694."
      nextLineIndex: 14
      eventId: 0
      eventValue: 0
    - choiceText: "\uC815\uAC70\uC7A5\uC758 \uBC00\uC785\uAD6D\uC790\uC640 \uB0B4\uBD80\uC790\uC5D0
        \uB300\uD574 \uC790\uC218\uD560 \uAC8C \uC788\uC5B4\uC694."
      nextLineIndex: 14
      eventId: 0
      eventValue: 0
    nextLineIndex: 14
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uADF8\uB3D9\uC548\uC758 \uBAA8\uB4E0 \uC77C\uC744 \uD138\uC5B4\uB193\uC558\uB2E4.
      \uC6B0\uC5F0\uD788 \uC774\uACF3\uC758 \uC628 \uAC83\uBD80\uD130, \uD0C8\uCD9C\uD558\uAE30
      \uC704\uD574 \uD588\uB358 \uAC83\uB4E4\uAE4C\uC9C0\uB3C4."
    choices: []
    nextLineIndex: 15
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: . . . .
    choices:
    - choiceText: "\uC8C4\uC1A1\uD574\uC694.. \uC560\uCD08\uC5D0 \uD558\uC9C0 \uB9D0\uC558\uC5B4\uC57C
        \uD588\uB294\uB370.."
      nextLineIndex: 16
      eventId: 0
      eventValue: 0
    nextLineIndex: 16
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC544\uB2D9\uB2C8\uB2E4. \uB355\uBD84\uC5D0 \uC218\uC0AC\uC5D0 \uB3C4\uC6C0\uC774
      \uB418\uACA0\uB124\uC694. \uD558\uC9C0\uB9CC \uC774 \uB3C4\uC6C0\uC740 \uC544\uBB34\uB798\uB3C4
      \uC800\uD76C \uB458\uB9CC \uC544\uB294 \uAC8C \uC88B\uC744 \uAC70 \uAC19\uC2B5\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 17
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uADF8 '\uBE0C\uB85C\uCEE4'\uB77C\uB294 \uC790\uB4E4\uC758 \uADDC\uBAA8\uAC00
      \uD655\uC778\uB418\uC9C0 \uC54A\uC740 \uC774\uC0C1 \uC624\uD788\uB824 \uC704\uD611\uC774
      \uC0DD\uAE38 \uC218 \uC788\uC5B4\uC694. \uADF8\uB7EC\uB2C8 \uB2F9\uC2E0\uB3C4
      \uADF8\uB9CC\uD07C \uB354 \uC870\uC2EC\uD788 \uC0DD\uD65C\uD574\uC57C \uD560\uAC81\uB2C8\uB2E4.
      \uC544\uBB34\uB798\uB3C4 \uB2F9\uC2E0\uB3C4 \uC800\uD76C \uC218\uC0AC\uB9DD
      \uB0B4\uC5D0 \uC788\uC744 \uAC81\uB2C8\uB2E4."
    choices:
    - choiceText: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4."
      nextLineIndex: 18
      eventId: 0
      eventValue: 0
    nextLineIndex: 18
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC544\uB9C8 \uBE68\uB77C\uB3C4 \uC77C\uC8FC\uC77C \uC774\uC0C1\uC740
      \uBC84\uD168\uC57C \uD560 \uAC81\uB2C8\uB2E4. \uBE0C\uB85C\uCEE4 \uCABD\uC740
      \uC5F0\uB77D\uD558\uC9C0 \uB9C8\uC138\uC694."
    choices:
    - choiceText: "\uAC10\uC0AC\uD569\uB2C8\uB2E4.."
      nextLineIndex: -1
      eventId: 0
      eventValue: 0
    nextLineIndex: -1
