  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: OnSSBuy
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uB4DC\uB514\uC5B4 \uC6B0\uC8FC\uC120\uC744 \uAD6C\uB9E4\uD560 \uB3C8\uC774
      \uBAA8\uC600\uB2E4."
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uADF8\uB798. \uB3C8\uC740 \uCDA9\uBD84\uD558\uAD70. \uC778\uADFC \uC0C1\uC810\uACFC\uC758
      \uAD00\uACC4\uB3C4 \uCDA9\uBD84\uD574. \uC774\uB7EC\uBA74 \uC6B0\uC8FC\uC120\uC744
      \uCD9C\uBC1C\uC2DC\uD0AC \uC900\uBE44\uB97C \uD574\uB3C4 \uB418\uACA0\uC5B4."
    choices:
    - choiceText: "\uC774\uC81C \uC9C0\uBE21\uB85C \uAC08 \uC218 \uC788\uB294 \uAC74\uAC00\uC694?"
      nextLineIndex: 2
      eventId: 0
      eventValue: 0
    nextLineIndex: 2
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uC544\uB2C8, \uC544\uC9C1. \uC548\uC804\uD55C \uD56D\uD574\uB97C \uC704\uD574\uC11C\uB77C\uBA74
      \uB2F9\uC5F0\uD788 \uCDA9\uBD84\uD55C \uC5F0\uB8CC\uB791, \uC815\uAC70\uC7A5
      \uC804\uCCB4\uC758 \uD589\uC815 \uC790\uB8CC\uAC00 \uD544\uC694\uD574. \uC774\uAC70
      \uBC1B\uC544."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uBE0C\uB85C\uCEE4\uAC00 \uB2F9\uC2E0\uC5D0\uAC8C \uC791\uC740 USB\uB97C
      \uAC74\uB0B8\uB2E4."
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uC774\uAC78 \uC815\uAC70\uC7A5 \uB0B4 \uC0AC\uBB34\uC6A9 \uCEF4\uD4E8\uD130\uC5D0
      \uAF42\uB294\uB2E4\uBA74, \uC644\uC804\uD788 \uC548\uC804\uD55C \uD558\uC62C\uB97C
      \uACC4\uC0B0\uD560 \uC218 \uC788\uC5B4."
    choices:
    - choiceText: "\uC704\uD5D8\uD558\uC9C0 \uC54A\uC744\uAE4C\uC694?"
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    nextLineIndex: 5
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uC704\uD5D8? \uC774\uC81C \uC640\uC11C? \uAC71\uC815\uC740 \uD560 \uD544\uC694
      \uC5C6\uB294 \uAC70 \uC54C\uC796\uC544. \uBCF4\uC548\uACFC \uB188\uB4E4\uC774
      \uB108\uB97C \uC7A1\uB294 \uC18D\uB3C4\uBCF4\uB2E4, \uB108\uAC00 \uD0C8\uCD9C\uD558\uB294
      \uAC8C \uB354 \uBE60\uB97C \uAC70\uC57C. \uADF8\uB798\uC11C, \uD560\uAC70\uC57C
      \uC548\uD560\uAC70\uC57C?"
    choices:
    - choiceText: "\uC7A0\uC2DC\uB9CC\uC694.."
      nextLineIndex: 6
      eventId: 0
      eventValue: 0
    nextLineIndex: 6
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uC0DD\uAC01\uD574\uBCF4\uC790.. \uD55C\uB2E4\uBA74, \uC870\uAE08 \uC704\uD5D8\uD558\uB354\uB77C\uB3C4
      \uCDA9\uBD84\uD788 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uC5B4.
      \uC774\uB7F0 \uC704\uD5D8\uD55C \uC0DD\uD65C\uB3C4 \uB05D\uC774\uC57C.)"
    choices: []
    nextLineIndex: 7
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uD558\uC9C0\uB9CC \uC9C4\uC9DC \uD55C\uB2E4\uBA74? \uBCF4\uC548\uACFC\uAC00
      \uADF8 USB\uC758 \uCD9C\uCC98\uB97C \uCC3E\uC744 \uAC70\uACE0, \uB098\uB3C4
      \uBE60\uB974\u3154 \uC7A1\uD790 \uAC70\uC57C. \uADF8\uB9AC\uACE0 \uC911\uC694\uD55C
      \uAC74, DB\uC5D0 \uC811\uC18D\uC2DC\uD0A4\uB294\uAC8C \uC5BC\uB9C8\uB098 \uC704\uD5D8\uD55C\uC9C0
      \uBAA8\uB974\uACA0\uC5B4.)"
    choices: []
    nextLineIndex: 8
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uB9CC\uC57D DB\uC5D0 \uC811\uADFC\uC2DC\uD0A8\uB2E4\uBA74, \uC228\uB0B3\uC740
      \uC0AC\uB78C\uB4E4\uC758 \uC815\uBCF4\uAC00 \uC720\uCD9C\uB420 \uAC70\uC57C.
      \uC5BC\uB9C8\uB098 \uD070 \uD53C\uD574\uAC00 \uC0DD\uAE38\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4.)"
    choices: []
    nextLineIndex: 9
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uD558\uC9C0\uB9CC \uC774\uAC8C \uC5C6\uB2E4\uBA74 \uB098\uB294 \uB354\uC774\uC0C1
      \uB3CC\uC544\uAC08 \uACF3\uB3C4 \uC5C6\uC5B4. \uACE7 \uC120\uAC70\uAC00 \uB05D\uB098\uB2C8\uAE4C,
      \uB108\uBB34 \uB2A6\uC5B4\uC9C0\uBA74 \uCCB4\uD3EC\uB2F9\uD560 \uC218 \uC788\uC744
      \uAC70\uC57C.)"
    choices: []
    nextLineIndex: 10
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uC5B4\uC774. \uB108\uBB34 \uC624\uB798 \uACE0\uBBFC\uD558\uB294 \uAC70
      \uC544\uB2C8\uC57C? \uC120\uD0DD\uC740 \uD558\uC154\uC57C\uC9C0. \uADF8\uB798\uC11C,
      \uC6B0\uC8FC\uC120 \uD0C0\uACE0 \uC9D1 \uAC08\uAC70\uC57C? \uC544\uB2C8\uBA74
      \uC548 \uD560\uAC70\uC57C?"
    choices: []
    nextLineIndex: 11
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC800\uB294..."
    choices: []
    nextLineIndex: -1
