  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uD734.. \uC774\uC81C \uD1F4\uADFC\uC778\uAC00?"
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC2E0\uC785! \uC774\uC81C \uD1F4\uADFC\uD558\uAC8C?"
    choices:
    - choiceText: "\uB124. \uC774\uC81C \uAC08 \uC900\uBE44\uD558\uB824\uACE0\uC694."
      nextLineIndex: 2
      eventId: 0
      eventValue: 0
    nextLineIndex: 1
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798? \uB09C \uC544\uC9C1\uC778\uB370^^. \uC544, \uADF8\uB9AC\uACE0
      \uC774\uAC74 \uC785\uC0AC \uC120\uBB3C."
    choices:
    - choiceText: "\uC774\uAC8C \uBB54\uAC00\uC694?"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    nextLineIndex: 1
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uBBFC\uC6D0 \uB300\uC751\uC774\uB791 \uC5EC\uAE30 \uC0DD\uD65C \uBA54\uB274\uC5BC\uC774\uC57C.
      \uC774\uAC70 \uBCF4\uACE0 \uC2E4\uC218 \uC5C6\uAC8C \uD574."
    choices:
    - choiceText: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!"
      nextLineIndex: 4
      eventId: 0
      eventValue: 0
    nextLineIndex: 4
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB9AC\uACE0, \uC785\uC0AC 7\uC77C\uAE4C\uC9C0\uB294 \uC778\uD134
      \uAE30\uAC04\uC774\uC57C. \uC774\uB3D9\uC548\uC740 \uBB38\uC81C \uC0DD\uAE30\uBA74
      \uB0B4\uAC00 \uB098\uC11C\uC11C \uC218\uC2B5\uD574\uC904 \uAC70\uC57C. \uC54C\uACA0\uC9C0?"
    choices:
    - choiceText: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!"
      nextLineIndex: -1
      eventId: 0
      eventValue: 0
    nextLineIndex: 4
