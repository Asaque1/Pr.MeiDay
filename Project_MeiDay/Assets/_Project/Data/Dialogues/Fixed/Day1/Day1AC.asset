  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uBBFC\uC6D0\uC778"
    text: '!#&^#$*-?'
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uC5B4, \uB0B4\uAC00 \uBAA8\uB974\uB294 \uB2E8\uC5B4\uC778\uAC00..? \uC774\uC0C1\uD558\uB2E4,
      \uBAA8\uB974\uB294 \uB2E8\uC5B4\uB294 \uC774\uC81C \uC5C6\uC744\uD150\uB370?)"
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC65C \uADF8\uB798 \uC2E0\uC785. \uBC8C\uC368 \uC77C\uD558\uAE30 \uC2EB\uC740
      \uAC70\uC57C?"
    choices:
    - choiceText: "(\uC0AC\uC2E4\uB300\uB85C \uB9D0\uD55C\uB2E4.)"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    - choiceText: "\uC544\uB2C8, \uADF8\uAC8C \uC544\uB2C8\uB77C.."
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    nextLineIndex: 2
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uB410\uC5B4. \uC0AC\uD22C\uB9AC\uB77C \uADF8\uB798. \uACE7 \uC788\uC73C\uBA74
      \uC120\uAC70\uAC70\uB4E0. \uC6D0\uB798 \uC774 \uAE30\uAC04 \uB418\uBA74 \uC2DC\uACE8\uC5D0\uC11C
      \uBAB0\uB824\uC640."
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uBB50, \uC0AC\uC2E4\uC0C1 \uCD95\uC81C\uB77C \uB2E4\uB4E4 \uB180\uB7EC\uC624\uB294
      \uAC70\uC9C0\uB9CC. \uB4E4\uC5B4\uBCF4\uBA74 \uC774\uD574\uB418\uB2C8\uAE4C
      \uC798 \uD574^^."
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC544, \uADF8\uB9AC\uACE0 \uB2E4\uB4E4 \uBC14\uC058\uB2C8\uAE4C 3\uBC88
      \uC815\uB3C4 \uD2C0\uB9AC\uBA74 \uD654\uB098\uC11C \uB098\uAC08\uAC70\uC57C.
      \uBB3C\uB860 \uADF8\uB807\uAC8C \uB418\uBA74 \uB3C8 \uBABB \uBC1B\uB294\uB2E4?"
    choices:
    - choiceText: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4!"
      nextLineIndex: -1
      eventId: 0
      eventValue: 0
    nextLineIndex: -1
