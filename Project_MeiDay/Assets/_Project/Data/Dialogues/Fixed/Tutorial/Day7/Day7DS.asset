  dialogueLines:
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC2E0\uC785, \uC654\uC5B4? \uC624\uB298\uB85C \uC778\uD134 \uAE30\uAC04\uC740
      \uB05D\uC774\uC57C."
    choices:
    - choiceText: "\uBC8C\uC368 \uADF8\uB807\uAC8C \uB410\uB124\uC694.."
      nextLineIndex: 1
      eventId: 0
      eventValue: 0
    - choiceText: "\uC774\uC820 \uC804\uBCF4\uB2E4 \uB354 \uC798 \uD560 \uAC70 \uAC19\uC2B5\uB2C8\uB2E4!"
      nextLineIndex: 1
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uBB50\uAC00 \uB410\uB4E0, \uC55E\uC73C\uB85C\uB294 \uC2E4\uC218\uD574\uB3C4
      \uB0B4\uAC00 \uBABB \uB3C4\uC640\uC918. \uC54C\uACA0\uC9C0?"
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB9AC\uACE0 \uACE7 \uB354 \uBA3C \uC9C0\uC5ED\uC5D0\uC11C \uC624\uB294
      \uBBFC\uC6D0\uC778\uB4E4\uC774 \uC624\uB294 \uAE30\uAC04\uC774\uC57C. \uC0AC\uB78C\uB3C4
      \uB354 \uB9CE\uC774 \uC624\uACE0, \uB9D0\uD558\uB294 \uAC83\uB3C4 \uB354 \uBCF5\uC7A1\uD574\uC9C8
      \uAC70\uC57C."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC9C0\uAE08\uAE4C\uC9C0 \uBC30\uC6B4 \uAC70 \uC798 \uD65C\uC6A9\uD574\uBD10."
    choices: []
    nextLineIndex: -1
