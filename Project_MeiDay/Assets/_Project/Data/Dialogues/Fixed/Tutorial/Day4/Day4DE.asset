  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC624\uB298\uB3C4 \uC77C\uC740 \uC5EC\uAE30\uC11C \uB05D\uC774\uB124.."
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uB3C4\uC2EC\uC9C0\uB97C \uC9C0\uB098 \uC9D1\uC73C\uB85C \uAC00\uB294
      \uAE38. \uB208\uC5D0 \uB204\uAD70\uAC00 \uBC1F\uD78C\uB2E4."
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 2427584657092548498, guid: aabf89596111e4649a11e506e39f1bf5, type: 3}
    speakerName: "\uBB34-\uBE44\uC62C\uB77C"
    text: "\uC800, \uC800\uAE30... \uC800\uD76C \uD53D\uD1A0\uB9AC\uC6B0\uC2A4 \uADF9\uB2E8
      \uB2E4\uC2DC \uACF5\uC5F0\uD569\uB2C8\uB2E4..!"
    choices:
    - choiceText: "(\uB9D0\uC744 \uAC78\uC5B4\uBCF8\uB2E4.)"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    - choiceText: "(\uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00\uBCF8\uB2E4.)"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    nextLineIndex: 3
  - speakerFace: {fileID: 2427584657092548498, guid: aabf89596111e4649a11e506e39f1bf5, type: 3}
    speakerName: "\uBB34-\uBE44\uC62C\uB77C"
    text: "\uC544, \uC548\uB155\uD558\uC138\uC694..!\uD639\uC2DC \uC601\uD654 \uC18C\uD488
      \uC88B\uC544\uD558\uC2DC\uB098\uC694? \uC800\uD76C \uADF9\uB2E8\uC774 \uC774\uC81C
      \uC0C8\uB86D\uAC8C \uC2DC\uC791\uD560 \uAC70\uAC70\uB4E0\uC694! \uADF8\uB798\uC11C
      \uADF8.. \uC800\uD76C \uC18C\uD488\uB4E4\uC744 \uD314\uACE0 \uC788\uB294\uB370,
      \uAD00\uC2EC \uC788\uC73C\uC2E0\uAC00\uC694?"
    choices:
    - choiceText: "\uC18C\uD488\uC774\uC694?"
      nextLineIndex: 4
      eventId: 0
      eventValue: 0
    nextLineIndex: 4
  - speakerFace: {fileID: 2427584657092548498, guid: aabf89596111e4649a11e506e39f1bf5, type: 3}
    speakerName: "\uBB34-\uBE44\uC62C\uB77C"
    text: "\uB124..! \uC804\uC5D0 \uC4F0\uB358 \uBD84\uC7A5\uC6A9 \uBB3C\uD488\uC774\uB77C\uB358\uAC00..
      \uC778\uD615\uC637\uC774\uB098 \uB300\uBCF8\uB3C4 \uC788\uC5B4\uC694! \uC5B8\uC81C\uB4E0
      \uC0C1\uAD00 \uC5C6\uC73C\uB2C8\uAE4C, \uAD00\uC2EC \uC788\uC73C\uC2DC\uBA74
      \uC640\uC8FC\uC138\uC694!"
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uAC70\uC808\uD560 \uD2C8\uB3C4 \uC5C6\uC774 \uADF9\uB2E8\uC758 \uC88C\uD45C\uB97C
      \uBC1B\uC558\uB2E4. \uC0AC\uB78C\uB4E4\uC758 \uC758\uC2EC\uC744 \uC9C0\uC6B0\uB824\uBA74
      \uD55C\uBC88 \uB4E4\uB7EC\uBCF4\uB294 \uAC83\uB3C4 \uC88B\uC744 \uAC83 \uAC19\uB2E4."
    choices: []
    nextLineIndex: -1
