MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: Day3DE
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC624\uB298\uB3C4 \uC5C5\uBB34 \uB05D! \uBB54\uAC00 \uC774\uC0C1\uD558\uC9C0\uB9CC,
      \uADF8\uB798\uB3C4 \uD3C9\uBC94\uD588\uC5B4."
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uBAA8\uB450 \uC9D1\uC911\uBC14\uB78D\uB2C8\uB2E4! \uC800\uB294 \uBCF4\uC548\uACFC
      5\uD300 \uD300\uC7A5 \uB808\uC628 \uB0D0\uBB38\uC785\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC9C0\uB09C 3\uC77C \uB3D9\uC548, \uC774\uACF3\uC744 \uD1B5\uACFC\uD558\uB294
      \uBB3C\uB958\uC5D0 \uB300\uD55C \uBE44\uBC00 \uC218\uC0AC\uB97C \uC9C4\uD589\uD558\uC600\uC2B5\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC774 \uACFC\uC815\uC5D0\uC11C \uC608\uC0C1\uBCF4\uB2E4 \uB354 \uB9CE\uC740
      \uBC00\uC785\uAD6D, \uBC00\uC218 \uB4F1\uC758 \uC815\uD669\uC774 \uD3EC\uCC29\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uADF8\uB807\uAE30\uC5D0 \uC624\uB298\uBD80\uB85C \uACF5\uC2DD\uC801\uC73C\uB85C
      \uC218\uC0AC\uB97C \uC2DC\uC791\uD558\uAC8C \uB418\uC5C8\uC2B5\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC800\uD76C\uB294 \uD604\uC7AC \uD0D0\uC815\uC744 \uACE0\uC6A9\uD574
      \uC218\uC0AC\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uC5EC\uB7EC\uBD84\uC740
      \uD589\uC815\uC5D0 \uACF5\uBC31\uC774 \uC5C6\uB3C4\uB85D \uC870\uCE58\uC640
      \uD611\uC870 \uBD80\uD0C1\uB4DC\uB9BD\uB2C8\uB2E4. \uC774\uC0C1."
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 0}
    speakerName: "\uC9C1\uC6D0\uB4E4"
    text: "\uADF8\uB7EC\uBA74 \uC55E\uC73C\uB85C \uB204\uAC00 \uB530\uB77C\uBD99\uAC70\uB098
      \uADF8\uB7EC\uB824\uB098?"
    choices: []
    nextLineIndex: 6
  - speakerFace: {fileID: 0}
    speakerName: "\uC9C1\uC6D0\uB4E4"
    text: "\uCD5C\uADFC\uC5D0 \uC2E0\uC785 \uD558\uB098\uAC00 \uAC11\uC790\uAE30
      \uC0AC\uB77C\uC84C\uB2E4\uB354\uB2C8, \uC800\uB798\uC11C\uC600\uB098."
    choices: []
    nextLineIndex: 7
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC5B4\uBA38\uC5B4\uBA38, \uC2E0\uC785. \uB4E4\uC5C8\uC5B4? \uD3C9\uC18C\uB77C\uBA74
      \uBC14\uB85C \uCCB4\uD3EC\uD588\uC744\uD150\uB370.. \uB108\uB3C4 \uC774\uC0C1\uD55C
      \uC0AC\uB78C \uBCF4\uBA74, \uBC14\uB85C \uBCF4\uC548\uACFC\uC5D0 \uC2E0\uACE0\uD574.
      \uC800 \uB188\uB4E4\uC774 \uC131\uACA9\uC740 \uC774\uC0C1\uD574\uB3C4 \uC77C
      \uD558\uB098\uB294 \uC798 \uD558\uB2C8\uAE4C."
    choices: []
    nextLineIndex: -1
