  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: Day2DS
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 4366155560704257353, guid: 994b79e8b9691fd4b90465f4db55ca29, type: 3}
    speakerName: "\uD5E4\uB974\uB9CC"
    text: "\uC5EC\uAE30\uAC00 \uADF8 \uB3D9\uC0AC\uBB34\uC18C \uB9DE\uB294\uAC00?"
    choices:
    - choiceText: "\uB124, \uB9DE\uC2B5\uB2C8\uB2E4 \uBB34\uC2A8 \uC77C \uB54C\uBB38\uC5D0
        \uC624\uC168\uB098\uC694?"
      nextLineIndex: 1
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 4366155560704257353, guid: 994b79e8b9691fd4b90465f4db55ca29, type: 3}
    speakerName: "\uD5E4\uB974\uB9CC"
    text: "\uAC70\uAE30 \uC544\uAC00\uC528, \uB098 \uC880 \uB3C4\uC640\uC918. \uC5EC\uAE30
      \uC9C1\uC6D0 \uD558\uB098\uAC00 \uCC45 \uBC18\uB0A9\uB3C4 \uC548\uD558\uACE0
      \uC788\uC5B4."
    choices:
    - choiceText: "\uB124. \uD639\uC2DC \uC131\uD568 \uAE30\uC5B5\uD558\uC2DC\uB098\uC694?"
      nextLineIndex: 2
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 4366155560704257353, guid: 994b79e8b9691fd4b90465f4db55ca29, type: 3}
    speakerName: "\uD5E4\uB974\uB9CC"
    text: "\uC774\uB984\uC740 \uBAA8\uB974\uACE0 \uADF8.. \uD68C\uC6D0 \uC774\uB984\uC774
      '\uBA38\uD540'\uC774\uC5C8\uB358 \uAC83\uB9CC \uAE30\uC5B5\uD574."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 4366155560704257353, guid: 994b79e8b9691fd4b90465f4db55ca29, type: 3}
    speakerName: "\uD5E4\uB974\uB9CC"
    text: "\uC544\uB2C8 \uADFC\uB370 \uCC45\uC744 \uBE4C\uB824\uAC00 \uB193\uACE0
      2\uAC1C\uC6D4 \uB3D9\uC548 \uBC18\uB0A9\uC744 \uC548 \uD558\uB294 \uAC74 \uB300\uCCB4
      \uBB34\uC2A8 $\"@#_#{13}%\""
    choices:
    - choiceText: "\uADF8\uB7EC\uBA74, \uC81C\uAC00 \uC804\uB2EC\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
      nextLineIndex: 4
      eventId: 0
      eventValue: 0
    nextLineIndex: 3
  - speakerFace: {fileID: 4366155560704257353, guid: 994b79e8b9691fd4b90465f4db55ca29, type: 3}
    speakerName: "\uD5E4\uB974\uB9CC"
    text: "\uC544, \uADF8\uB798\uC8FC\uACA0\uB098?"
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 4366155560704257353, guid: 994b79e8b9691fd4b90465f4db55ca29, type: 3}
    speakerName: "\uD5E4\uB974\uB9CC"
    text: "\uADF8\uB7EC\uBA74 \uC774\uB9CC \uAC00\uBCF4\uACA0\uB124. \uB0B4\uC77C\uAE4C\uC9C0
      \uC548 \uC628\uB2E4\uBA74 \uD68C\uC6D0 \uC790\uACA9\uC744 \uBC15\uD0C8\uD558\uACA0\uB2E4\uB294
      \uAC83\uB3C4 \uB9D0\uC774\uC57C."
    choices: []
    nextLineIndex: -1
