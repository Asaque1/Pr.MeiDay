  dialogueLines:
  - speakerFace: {fileID: -5711646217690350408, guid: d650d39ed8584f442a150b444af4a08b, type: 3}
    speakerName: ???
    text: "\uC548\uB155, \uCE5C\uAD6C! \uC0AC\uB294 \uAC74 \uC5B4\uB54C? \uBB50\uAC00
      \uB410\uB4E0, \uC774\uC81C \uC7AC\uBC0C\uB294 \uAC83\uB9CC \uC788\uC744 \uAC70\uC57C!"
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: -5711646217690350408, guid: d650d39ed8584f442a150b444af4a08b, type: 3}
    speakerName: ???
    text: "\uBE68\uAC04 \uC0AC\uD0D5\uACFC \uD30C\uB780 \uC0AC\uD0D5. \uB458 \uC911
      \uBB58 \uACE0\uB97C\uB798?"
    choices:
    - choiceText: "\uBE68\uAC04 \uC0AC\uD0D5"
      nextLineIndex: 2
      eventId: 0
      eventValue: 10
    - choiceText: "\uD30C\uB780 \uC0AC\uD0D5"
      nextLineIndex: 3
      eventId: 1
      eventValue: -2
    nextLineIndex: 2
  - speakerFace: {fileID: -5711646217690350408, guid: d650d39ed8584f442a150b444af4a08b, type: 3}
    speakerName: ???
    text: "\uCCB4\uB9AC\uB9DB\uC774\uC57C! \uC624\uB298\uB3C4 \uC88B\uC740 \uD558\uB8E8
      \uBCF4\uB0B4!"
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: -5711646217690350408, guid: d650d39ed8584f442a150b444af4a08b, type: 3}
    speakerName: ???
    text: "\uBE14\uB8E8\uBCA0\uB9AC \uB9DB\uC774\uC57C! \uC624\uB298\uB3C4 \uC88B\uC740
      \uD558\uB8E8 \uBCF4\uB0B4!"
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uCCB4\uB9AC \uB9DB\uC774 \uC9C4\uD55C \uC0AC\uD0D5\uACFC \uB3D9\uC804\uC744
      \uBC1B\uC558\uB2E4."
    choices: []
    nextLineIndex: -1
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uBD80\uB4DC\uB7EC\uC6B4 \uBE14\uB8E8\uBCA0\uB9AC \uB9DB\uC758 \uC0AC\uD0D5\uC744
      \uBC1B\uC558\uB2E4. \uD5A5\uC774 \uBAB8\uC5D0\uC11C \uC548 \uBE60\uC9C0\uB294
      \uAC83 \uAC19\uB2E4."
    choices: []
    nextLineIndex: -1
