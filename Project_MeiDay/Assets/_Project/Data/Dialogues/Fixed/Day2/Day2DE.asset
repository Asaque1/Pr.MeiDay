  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: Day2DE
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC5B4 \uC2E0\uC785. \uC77C \uB05D\uB0AC\uC5B4? \uBB50 \uB354 \uD560\uC77C\uC774\uB77C\uB3C4
      \uC788\uB294 \uAC70\uC57C?"
    choices:
    - choiceText: "(\uB178\uBA5C\uB77C\uC758 \uBD80\uD0C1\uC744 \uC804\uD55C\uB2E4.)"
      nextLineIndex: 1
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC544.. \uB0B4\uAC00 \uC78A\uACE0 \uC788\uC5C8\uB098?"
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798 \uAE30\uC5B5\uB0AC\uB2E4! \uC804\uC5D0 \uBE4C\uB824\uB454
      '\uC678\uACC4 \uC0AC\uD22C\uB9AC \uC0AC\uC804 -v.243.1.23'\uC774 \uC788\uC5C8\uB124."
    choices:
    - choiceText: "\uC0AC\uD22C\uB9AC \uC0AC\uC804\uC774\uC694?"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    - choiceText: "\uADF8\uB7F0\uAC8C \uC788\uC5C8\uB098\uBCF4\uB124\uC694?"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    nextLineIndex: 3
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798. \uC124\uB9C8 \uC774 \uB113\uC740 \uC6B0\uC8FC\uC5D0 \uADF8\uB7F0
      \uAC83\uB3C4 \uC5C6\uC744 \uAC70\uB77C \uC0DD\uAC01\uD588\uC5B4?"
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uB108\uD55C\uD14C\uB3C4 \uD544\uC694\uD560 \uAC70\uC57C. \uBA70\uCE60\uB9CC
      \uC9C0\uB098\uB3C4 \uC2DC\uACE8 \uC678\uACC4\uC778\uB4E4\uC774 \uB354 \uBAB0\uB824\uC62C
      \uD14C\uB2C8\uAE4C."
    choices:
    - choiceText: "\uC54C\uB824\uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    nextLineIndex: 5
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798. \uC11C\uC810 \uC88C\uD45C\uB294 \uB0B4\uAC00 \uC54C\uB824\uC904
      \uD14C\uB2C8\uAE4C \uC624\uB298 \uD55C\uBC88 \uB4E4\uB824."
    choices: []
    nextLineIndex: 6
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uB108\uAC00 \uC77C \uBABB\uD558\uBA74 \uB098\uB3C4 \uD798\uB4E4\uC5B4\uC9C0\uB294
      \uAC70 \uC78A\uC9C0 \uB9D0\uACE0."
    choices: []
    nextLineIndex: -1
