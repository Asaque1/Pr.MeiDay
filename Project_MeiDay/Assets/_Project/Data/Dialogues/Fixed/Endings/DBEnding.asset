%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: DBEnding
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uC624\uB298\uB3C4 \uC5C5\uBB34 \uB05D!"
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 0}
    speakerName: "\uBA54\uC138\uC9C0"
    text: "\"\uC624\uB298\uC774\uC57C. \uC544\uB798 \uC88C\uD45C\uB300\uB85C. \uCD5C\uB300\uD55C
      \uBE68\uB9AC.\""
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "(\uC624\uB298\uC774 \uB9C8\uC9C0\uB9C9\uC774\uAD6C\uB098.. \uC5EC\uAE30\uB3C4
      \uC815\uB4E4\uC5C8\uB294\uB370,\uC870\uAE08\uC740 \uC544\uC27D\uB2E4 \uD574\uC57C\uD558\uB098?)"
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uB810\uB80C"
    text: "\uC2E0\uC785! \uC544\uB2C8, \uC774\uC820 \uC2E0\uC785\uC774\uB77C \uD558\uAE30\uC5D0\uB3C4
      \uADF8\uB7F0\uAC00?"
    choices:
    - choiceText: "\uBB34\uC2A8 \uC77C\uC774\uC2E0\uAC00\uC694?"
      nextLineIndex: 4
      eventId: 0
      eventValue: 0
    nextLineIndex: 4
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC544\uB2C8, \uBCC4\uAC74 \uC544\uB2C8\uACE0. \uC77C\uB3C4 \uAF64 \uD588\uB294\uB370,
      \uB05D\uB098\uACE0 \uC2DD\uC0AC\uB77C\uB3C4 \uD558\uB294\uAC8C \uC88B\uC744
      \uAC70 \uAC19\uC544\uC11C."
    choices:
    - choiceText: "\uC8C4\uC1A1\uD574\uC694. \uC624\uB298\uC740 \uD798\uB4DC\uB124\uC694."
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    - choiceText: "\uC57D\uC18D\uC774 \uC788\uB294\uB370.. \uC5B4\uB824\uC6B8 \uAC70
        \uAC19\uB124\uC694."
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    nextLineIndex: 5
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798? \uADF8\uB7FC \uBB50 \uB0B4\uC77C\uC774\uB77C\uB3C4 \uAD1C\uCC2E\uC9C0.
      \uC88B\uC544\uD558\uB294 \uC74C\uC2DD \uC788\uC5B4?"
    choices:
    - choiceText: "(\uC55E\uC73C\uB85C \uBABB \uAC08\uAC70\uB77C \uC124\uBA85\uD55C\uB2E4.)"
      nextLineIndex: 6
      eventId: 0
      eventValue: 0
    - choiceText: "(\uADF8\uB9CC \uB450\uACA0\uB2E4 \uC124\uBA85\uD55C\uB2E4.)"
      nextLineIndex: 7
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798? \uC544\uC27D\uAC8C \uB410\uB124. \uC2DC\uAC04 \uB0A0 \uB54C
      \uB9D0\uD574. \uC6B0\uB9AC \uD300 \uB2E4 \uAC19\uC774 \uAC08 \uC218\uB3C4 \uC788\uC73C\uB2C8\uAE4C.
      \uADFC\uB370 \uC911\uC694\uD55C \uC77C\uC774\uB77C\uB3C4 \uC788\uB294 \uAC70\uC57C?"
    choices:
    - choiceText: "\uC9D1\uC73C\uB85C \uAC08\uAC70\uC5D0\uC694."
      nextLineIndex: 8
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uB0B4\uC77C\uBD80\uD130? \uADF8\uB798.. \uBB50, \uADF8\uB7F4 \uC218 \uC788\uC9C0.
      \uC774\uC720\uB77C\uB3C4 \uC54C\uB824\uC918. \uB9D0\uD558\uAE30 \uD798\uB4E0
      \uC774\uC720\uC57C?"
    choices:
    - choiceText: "\uC9D1\uC73C\uB85C \uAC08 \uAC70\uC5D0\uC694."
      nextLineIndex: 8
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC9D1? \uC9D1\uC774\uB77C.. \uADF8\uB798. \uADF8\uB7F4 \uC218 \uC788\uC9C0.
      \uC9D1\uC774\uB780 \uAC74 \uB298 \uC88B\uC73C\uB2C8\uAE4C. \uADF8\uB798. \uBB50,
      \uC544\uC27D\uAC8C \uB410\uB124. \uC9D1\uC774 \uB9CE\uC774 \uBA3C \uAC70\uC57C?"
    choices:
    - choiceText: "\uB124. \uC544-\uC8FC \uBA40\uC5B4\uC694. \uC55E\uC73C\uB85C \uBCF4\uAE30
        \uD798\uB4E4 \uAC70\uC5D0\uC694."
      nextLineIndex: 9
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798? \uADF8\uB798\uB3C4 \uC77C \uC2DC\uD0AC\uB9CC \uD574\uC84C\uB294\uB370,
      \uC544\uC27D\uAC8C \uB410\uB124. \uADF8\uB798\uB3C4 \uB355\uBD84\uC5D0 \uC120\uAC70\uCCA0
      \uC27D\uAC8C \uB05D\uB100\uC5B4."
    choices:
    - choiceText: "\uAC10\uC0AC\uD569\uB2C8\uB2E4."
      nextLineIndex: 10
      eventId: 0
      eventValue: 0
    nextLineIndex: 10
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uADF8\uB798. \uADF8\uB7FC \uC9C4\uC9DC \uC77C\uB9CC \uC2DC\uD0A4\uACE0
      \uAC00\uB294 \uAC70\uB124. \uC778\uC0AC\uACFC\uC5D0\uB294 \uB0B4\uAC00 \uB9D0\uD560\uD14C\uB2C8\uAE4C.
      \uBA3C\uC800 \uB4E4\uC5B4\uAC00 \uBD10. \uADF8\uB9AC\uACE0 \uBB3C\uAC74\uB4E4\uC740
      \uB2E4 \uAC00\uC838\uAC00\uACE0. \uC5EC\uAE30 \uC560\uB4E4\uC740 \uD1F4\uC0AC\uCC98\uB9AC\uB418\uBA74
      \uBABB \uB4E4\uC5B4\uC640."
    choices: []
    nextLineIndex: 11
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uACE0\uB9C8\uC6E0\uC5B4\uC694. \uC774\uB9CC \uBA3C\uC800 \uB4E4\uC5B4\uAC00\uBCFC\uAC8C\uC694!"
    choices: []
    nextLineIndex: 12
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uBA54\uC138\uC9C0 \uC18D \uC88C\uD45C\uB97C \uD5A5\uD574 \uB6F4\uB2E4.
      \uC911\uAC04\uC5D0 \uBCF4\uC548\uACFC \uC0AC\uB78C\uB4E4\uC774 \uC778\uC0AC\uB97C
      \uAC74\uB0C8\uC9C0\uB9CC \uADF8\uB7F4 \uC2DC\uAC04\uB3C4 \uC5C6\uC5C8\uB2E4.
      \uC9D1\uC774 \uB208 \uC55E\uC5D0 \uC788\uB2E4."
    choices: []
    nextLineIndex: 13
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uBE68\uB9AC \uC654\uAD70. \uC606\uC5D0 \uC788\uB294 \uC774\uAC8C \uB108\uAC00
      \uD0C0\uACE0 \uAC08 \uC6B0\uC8FC\uC120\uC774\uC57C. \uAF64 \uAD6C\uC2DD\uC774\uB77C
      \uACE0\uCE58\uB294 \uB370 \uC560 \uBA39\uC5C8\uC9C0."
    choices:
    - choiceText: "\uACE0\uB9C8\uC6CC\uC694."
      nextLineIndex: 14
      eventId: 0
      eventValue: 0
    - choiceText: "\uC774\uC81C \uC9C4\uC9DC \uC9D1\uC73C\uB85C \uAC00\uB294 \uAC70\uAD70\uC694.."
      nextLineIndex: 15
      eventId: 0
      eventValue: 0
    nextLineIndex: 14
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uAC10\uC0AC\uB294 \uB410\uC5B4. \uC11C\uB85C \uB3C4\uC6C0 \uBC1B\uC558\uC73C\uBA74
      \uB41C \uAC70\uC9C0. \uB355\uBD84\uC5D0 \uC6B0\uB9AC\uB3C4 \uC544\uC8FC \uD070
      \uC9C4\uC804\uC774 \uC788\uC5C8\uACE0."
    choices: []
    nextLineIndex: 16
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uADF8\uB798. \uAC00\uB294 \uAC70\uC57C. \uC544\uB9C8 \uC801\uC9C0 \uC54A\uAC8C
      \uAC78\uB9AC\uACA0\uC9C0\uB9CC \uB9D0\uC774\uC57C. \uADF8\uB798\uB3C4 \uC911\uAC04\uC5D0
      \uB4E4\uD0A4\uC9C0\uB294 \uC54A\uC744 \uAC70\uB2C8\uAE4C \uAC71\uC815 \uB9D0\uACE0."
    choices: []
    nextLineIndex: 16
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: "\uBE0C\uB85C\uCEE4"
    text: "\uAF64 \uAE34 \uD56D\uD574\uAC00 \uB420 \uAC70\uC57C. \uADF8\uB3D9\uC548
      \uACE0\uB9C8\uC6E0\uC5B4. \uB355\uBD84\uC5D0 \uB098\uB3C4 \uB3C4\uC6C0 \uB9CE\uC774
      \uBC1B\uC558\uACE0. \uB4E4\uC5B4\uAC00 \uBD10. \uBC14\uB85C \uCD9C\uBC1C\uD574\uB3C4
      \uB3FC."
    choices:
    - choiceText: "\uB124!"
      nextLineIndex: 17
      eventId: 0
      eventValue: 0
    nextLineIndex: 17
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC6B0\uC8FC\uC120 \uB0B4\uBD80\uB294 \uAE54\uB054\uD558\uB2E4. \uBA87\uBA87
      \uC7A5\uBE44\uB294 \uD760\uC9D1\uC774 \uC788\uB294 \uBD80\uBD84\uC774 \uBCF4\uC600\uC9C0\uB9CC
      \uB300\uBD80\uBD84\uC740 \uC0C8\uAC83\uCC98\uB7FC \uAD11\uC774 \uB0AC\uB2E4."
    choices:
    - choiceText: "\uAC00\uC790. \uC9D1\uC73C\uB85C."
      nextLineIndex: 18
      eventId: 0
      eventValue: 0
    nextLineIndex: 18
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uACC4\uAE30\uD310\uC5D0 \uC788\uB294 \uBE68\uAC04 \uBC84\uD2BC\uC744
      \uB204\uB978\uB2E4. \uADF8\uB7EC\uC790 \uC6B0\uC8FC\uC120\uC774 \uC870\uAE08\uC529
      \uD754\uB4E4\uB9AC\uBA70 \uC704\uB85C \uB5A0\uC62C\uB790\uB2E4. \uADF8\uB7EC\uB354\uB2C8
      \uBE60\uB974\uAC8C, \uBE68\uB824\uB4E4\uC5B4\uAC00\uB4EF \uC774\uB3D9\uD588\uB2E4.
      \uC7A0\uC2DC \uB4A4 \uCC3D \uBC16\uC73C\uB85C \uBCF4\uACE0 \uC2F6\uB358 \uAC83\uC774
      \uBCF4\uC774\uAE30 \uC2DC\uC791\uD55C\uB2E4."
    choices:
    - choiceText: "\uC9C0\uAD6C\uB2E4!"
      nextLineIndex: 19
      eventId: 0
      eventValue: 0
    nextLineIndex: 19
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC9D1\uC774\uB2E4. \uD478\uB978 \uBC14\uB2E4. \uC624\uB7AB\uB3D9\uC548
      \uBCF4\uACE0 \uC2F6\uB358 \uAC83\uC774\uB2E4. \uD48D\uACBD\uC774\uB784 \uAC83\uB3C4
      \uC5C6\uB294 \uC6B0\uC8FC\uC5D0\uC11C, \uADF8\uB9AC\uC6B4 \uD478\uB978 \uBCC4\uC774
      \uBCF4\uC778\uB2E4."
    choices: []
    nextLineIndex: 20
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC9C0\uAE08\uAE4C\uC9C0\uC758 \uC774\uC57C\uAE30\uB294, \uC0AC\uB78C\uB4E4\uC774
      \uBBFF\uC9C0 \uC54A\uC744 \uAC83\uC774\uB2E4. \uD558\uC9C0\uB9CC \uC911\uC694\uD55C
      \uAC83\uC740, \uB9C8\uC74C \uC18D\uC5D0\uB294 \uAC04\uC9C1\uD560\uB9CC\uD55C,
      \uBB34\uC12D\uC9C0\uB9CC \uC88B\uC558\uB358 \uCD94\uC5B5\uC774 \uB420 \uAC83\uC774\uB2E4."
    choices: []
    nextLineIndex: 21
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\"\uCC29\uB959\uC9C0 \uC124\uC815 \uC644\uB8CC. \uADA4\uB3C4\uC5D0 \uC9C4\uC785\uD569\uB2C8\uB2E4.\""
    choices: []
    nextLineIndex: -1
