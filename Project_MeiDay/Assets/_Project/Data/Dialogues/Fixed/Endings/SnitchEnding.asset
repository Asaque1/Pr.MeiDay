  m_Script: {fileID: 11500000, guid: 567fa180cbeff0043a09c0e520bf426e, type: 3}
  m_Name: SnitchEnding
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueLines:
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uD734.. \uC624\uB298\uB3C4 \uB05D.."
    choices: []
    nextLineIndex: 1
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC2E0\uC785. \uC694\uC998 \uBB50 \uC788\uC5B4?"
    choices:
    - choiceText: "\uB124? \uBB50\uAC00\uC694?"
      nextLineIndex: 2
      eventId: 0
      eventValue: 0
    nextLineIndex: 2
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uAC11\uC790\uAE30 \uC5BC\uAD74\uC5D0 \uC6C3\uC74C\uB3C4 \uC5C6\uACE0,
      \uBB34\uC2A8 \uCAD3\uAE30\uB294 \uC0AC\uB78C\uCC98\uB7FC \uADF8\uB7EC\uB2C8\uAE4C."
    choices: []
    nextLineIndex: 3
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC778\uACF5"
    text: "\uADF8\uAC8C...."
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC704 \uC0AC\uB78C\uB4E4"
    text: "\uD5C9..! \uC2DC\uC7A5\uB2D8\uC774\uB2E4!"
    choices: []
    nextLineIndex: 5
  - speakerFace: {fileID: 0}
    speakerName: "\uC8FC\uC704 \uC0AC\uB78C\uB4E4"
    text: "\uC2DC\uC7A5\uB2D8\uC774? \uC5EC\uAE30\uB294 \uC65C?"
    choices: []
    nextLineIndex: 6
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: "\uD5EC\uB80C"
    text: "\uC5B4? \uC2DC\uC7A5\uB2D8! \uC548\uB155\uD558\uC2ED\uB2C8\uAE4C!"
    choices: []
    nextLineIndex: 7
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC2DC\uC7A5?"
    text: "\uD5C8\uD5C8\uD5C8. \uBC18\uAC11\uC2B5\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 8
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC2DC\uC7A5. \uC774 \uC815\uAC70\uC7A5\uC758 \uC815\uCE58\uB294 \uC5B8\uB73B
      \uB4E4\uC740 \uAE30\uC5B5\uC774 \uC788\uB2E4. \uC774\uC2A4\uBA54\uD2B8 \uD30C\uC0E4.
      \uC2DC\uC7A5 3\uC120\uC744 \uC900\uBE44\uD558\uACE0 \uC788\uB294 \uAC70\uBB3C.
      \uC2DC\uC7A5\uC774 \uC544\uB2C8\uB358 \uC2DC\uC808\uC5D0\uB3C4 \uC0AC\uC2E4\uC0C1
      \uC815\uAC70\uC7A5\uC758 \uC8FC\uC778."
    choices: []
    nextLineIndex: 9
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uBC18\uAC11\uC2B5\uB2C8\uB2E4."
    choices:
    - choiceText: "\uBC14, \uBC18\uAC11\uC2B5\uB2C8\uB2E4!"
      nextLineIndex: 10
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC624\uC168\uAD70\uC694."
    choices: []
    nextLineIndex: 11
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uADF8\uB798\uC694. \uB2F9\uC2E0\uC774 \uBCF4\uC548\uACFC \uCC45\uC784\uC790\uC778\uAC00?"
    choices: []
    nextLineIndex: 12
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uB124. \uB9DE\uC2B5\uB2C8\uB2E4. \uBAA8\uC2DC\uACA0\uC2B5\uB2C8\uB2E4.
      \uC2E0\uC785! \uB108\uB3C4 \uB530\uB77C\uC640."
    choices:
    - choiceText: "\uB124?! \uC800\uB3C4\uC694?"
      nextLineIndex: 13
      eventId: 0
      eventValue: 0
    nextLineIndex: 13
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uB808\uC628\uC740 \uC2DC\uC7A5\uACFC \uD568\uAED8 \uBA85\uD328\uC870\uCC28
      \uC5C6\uB294 \uBC00\uC2E4\uB85C \uB370\uB824\uAC04\uB2E4. \uBCF4\uC548\uC694\uC6D0\uC740
      \uB0B4 \uBAB8\uC744 \uC7A0\uC2DC \uC218\uC0C9\uD558\uB354\uB2C8, \uBB38\uC5F4
      \uC5F4\uC5B4\uC900."
    choices: []
    nextLineIndex: 14
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uADF8.. \uC778\uAC04 \uBD84? \uC774\uB807\uAC8C \uBD80\uB974\uACA0\uC2B5\uB2C8\uB2E4.
      \uC81C\uAC00 \uBCF4\uACE0\uC11C\uC5D0 \uBC1B\uC740 \uB0B4\uC6A9\uC774 \uB9DE\uB2E4\uBA74\uC694.."
    choices:
    - choiceText: "\uB124?"
      nextLineIndex: 15
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uBBF8\uC548\uD569\uB2C8\uB2E4. \uC800 \uC778\uAC04 \uCE5C\uAD6C\uB294
      \uC544\uC9C1 \uC0C1\uD669\uC744 \uBAA8\uB985\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 16
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uC544, \uADF8\uB7FC \uB9D0\uD574\uC8FC\uAC8C."
    choices: []
    nextLineIndex: 17
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uC2E0\uC785, \uC798 \uB4E4\uC5B4. \uC6B0\uB9AC\uB294 \uC9C0\uAE08\uAE4C\uC9C0
      \uC9C0\uC18D\uC801\uC73C\uB85C \uBC00\uC218\uC640 \uD574\uD0B9\uC744 \uC2DC\uB3C4\uD558\uB358
      \uBC94\uC8C4\uC870\uC9C1\uC744 \uCAD3\uACE0 \uC788\uC5C8\uC5B4. \uADF8 \uACFC\uC815\uC5D0\uC11C
      \uB108\uAC00 \uC218\uC0AC\uB9DD\uC5D0 \uB2FF\uC558\uACE0."
    choices: []
    nextLineIndex: 18
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uB108\uB97C \uC218\uC0AC\uD558\uB824 \uD588\uB294\uB370, \uB108\uAC00
      \uC790\uC218\uD55C \uAC70\uC57C. \uADF8 \uB355\uBD84\uC5D0 \uC6B0\uB9AC\uB294
      \uC5B4\uC81C, \uADF8 \uC77C\uB2F9\uC744 \uCCB4\uD3EC\uD588\uACE0."
    choices: []
    nextLineIndex: 19
  - speakerFace: {fileID: -9077174886096068995, guid: 66b02e9ee45c827428874ee60a03b86e, type: 3}
    speakerName: "\uB808\uC628"
    text: "\uADF8\uB798\uC11C \uB108\uC5D0 \uB300\uD55C \uC815\uBCF4\uB97C \uC5B4\uCA54
      \uC218 \uC5C6\uC774 \uC2DC\uC7A5\uB2D8\uC5D0\uAC8C \uBCF4\uACE0\uD55C \uAC70\uC57C.
      \uB2E4\uD589\uD788\uB3C4, \uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5\uB2D8\uC774
      \uB110 \uBCF4\uACE0\uC2F6\uB2E4\uACE0 \uD558\uC2E0\uAC70\uACE0."
    choices: []
    nextLineIndex: 20
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uB124. \uC0AC\uC2E4\uB300\uB85C \uC785\uB2C8\uB2E4."
    choices: []
    nextLineIndex: 21
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uC800\uB3C4 \uCC98\uC74C\uC5D0\uB294 \uBCF4\uACE0\uAC00 \uBBFF\uAE30\uC9C0
      \uC54A\uC558\uC2B5\uB2C8\uB2E4. \uAC00\uCD95\uC778 \uC778\uAC04\uC774 \uC800\uD76C
      \uD2C8\uC5D0 \uC11E\uC5EC\uC11C \uD589\uC815\uC774\uB2C8 \uD558\uB294 \uAC74
      \uADF8\uB807\uB2E4 \uCCD0\uB3C4. \uC624\uD788\uB824 \uBC94\uC8C4\uC790\uB97C
      \uC2E0\uACE0\uD558\uACE0 \uADF8\uB4E4\uC758 \uC740\uAC70\uC9C0\uAE4C\uC9C0
      \uCC3E\uB2E4\uB2C8\uC694."
    choices: []
    nextLineIndex: 22
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uADF8\uB798\uC11C \uB9D0\uC785\uB2C8\uB2E4. \uC800\uC5D0\uAC8C \uB2F9\uC2E0\uC744
      \uB3C4\uC6B8 \uBC29\uBC95\uC774 \uC788\uC2B5\uB2C8\uB2E4. \uC800\uD76C\uAC00
      \uB2F9\uC2E0\uC744 \uC9C0\uAD6C\uB85C \uBCF4\uB0B4\uB4DC\uB9B4 \uC218 \uC788\uC744
      \uAC81\uB2C8\uB2E4."
    choices:
    - choiceText: "\uC815\uB9D0\uC694?"
      nextLineIndex: 23
      eventId: 0
      eventValue: 0
    nextLineIndex: 23
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uB124. \uB300\uC2E0 \uAC00\uC2E4 \uB584, \"\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5
      \uB355\uBD84\uC5D0 \uC9D1\uC73C\uB85C \uB3CC\uC544\uAC08 \uC218 \uC788\uC5C8\uB2E4.\",
      \"\uCC28\uBCC4 \uBC1B\uC544 \uD798\uB4E4\uC5C8\uB2E4.\" \uC774\uB7F0 \uB9D0\uB9CC
      \uD574\uC8FC\uC2DC\uBA74 \uB429\uB2C8\uB2E4."
    choices:
    - choiceText: "\uB124! \uC644\uC804 \uAC00\uB2A5\uD569\uB2C8\uB2E4!"
      nextLineIndex: 24
      eventId: 0
      eventValue: 0
    nextLineIndex: 24
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC774\uD6C4\uB85C\uB3C4 \uD55C \uC2DC\uAC04 \uC815\uB3C4 \uC774\uC2A4\uBA54\uD2B8
      \uC2DC\uC7A5\uACFC \uC55E\uC73C\uB85C\uC758 \uACC4\uD68D\uACFC \uC77C\uC815\uC5D0
      \uB300\uD574 \uC774\uC57C\uAE30\uD588\uB2E4. \uC774\uD6C4 \uADF8\uAC00 \uB098\uAC08
      \uB54C\uB294 '\uC2E4\uBB34\uC790\uB4E4\uACFC \uBCF4\uC548 \uACC4\uD68D \uD68C\uC758'\uB77C
      \uD558\uB294 \uAC83\uC744 \uB4E4\uC5C8\uC9C0\uB9CC, \uC911\uC694\uD558\uC9C0
      \uC54A\uAC8C \uC0DD\uAC01\uD558\uAE30\uB85C \uD588\uB2E4."
    choices: []
    nextLineIndex: 25
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uBA70\uCE60 \uB4A4, \uB098\uB294 \uC9C0\uAE08\uAE4C\uC9C0
      \uC228\uACA8\uC628 \uAC83\uC774 \uBB34\uC0C9\uD560 \uC815\uB3C4\uB85C \uD654\uB824\uD558\uAC8C
      \uAD11\uC7A5\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
    choices: []
    nextLineIndex: 26
  - speakerFace: {fileID: -5314948207850937386, guid: f1eb3fb6b6c505748a3353caeb1994b0, type: 3}
    speakerName: "\uC774\uC2A4\uBA54\uD2B8 \uC2DC\uC7A5"
    text: "\uC6B0\uB9AC\uB294 \uC9C0\uAE08\uAE4C\uC9C0\uB3C4 \uCC28\uBCC4 \uC18D\uC5D0
      \uC0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4! \uC6B0\uB9AC\uB294 \uC774 \uC9C0\uAD6C\uC778\uC744
      \uC2DC\uC791\uC73C\uB85C \uB354 \uB113\uC740 \uC6B0\uC8FC\uC5D0 \uC5F4\uB9B0
      \uC815\uAC70\uC7A5\uC774 \uB418\uC5B4\uC57C \uD569\uB2C8\uB2E4!"
    choices: []
    nextLineIndex: 27
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC2DC\uC7A5\uC740 \uB0B4 \uC55E\uC5D0\uC11C \uD070 \uBAA9\uC18C\uB9AC\uB85C
      \uC5F0\uC124\uD558\uB4EF \uB9D0\uD588\uB2E4. \uC774\uD6C4 \uB098\uB294 3\uBA85\uC758
      \uBCF4\uB514\uAC00\uB4DC\uC640 \uD568\uAED8 \uC6B0\uC8FC\uC120 \uCC29\uB959\uC7A5\uC73C\uB85C
      \uAC14\uB2E4. \uADF8\uACF3\uC5D0\uB294 \uC804\uC5D0 \uB9CC\uB0AC\uB358 \uB9CE\uC740
      \uC0AC\uB78C\uB4E4\uC774 \uB9C8\uC911 \uB098\uC640 \uC788\uC5C8\uB2E4."
    choices: []
    nextLineIndex: 28
  - speakerFace: {fileID: 533347179103727038, guid: 90c5cc9267e526a418d62b40bd6f2a96, type: 3}
    speakerName: 
    text: "\uC120\uBC30\uB2D8\uC740 \uB098\uB97C \uBABB\uB9C8\uB545\uD558\uAC8C \uCCD0\uB2E4\uBCF4\uBA70
      \"\uB098\uD55C\uD14C\uB294 \uC54C\uB824\uC918\uB3C4 \uB410\uB358 \uAC70 \uC544\uB2C8\uC57C?\"
      \uB77C\uB294 \uB9D0\uACFC \uD568\uAED8 \uAC71\uC815\uD574\uC92C\uACE0,"
    choices: []
    nextLineIndex: 29
  - speakerFace: {fileID: 6619098858871695494, guid: 8d85d9571c49489449632b83ee86c469, type: 3}
    speakerName: 
    text: "\uC9D1\uC8FC\uC778\uB2D8\uC740 \uBB50.. \"\uBAB8 \uC870\uC2EC\uD558\uACE0
      \uAF2D \uC5F0\uB77D\uD558\uB77C\"\uBA70 \uAC11\uC790\uAE30 \uAC00\uC871\uCC98\uB7FC
      \uD589\uC138\uD588\uB2E4."
    choices: []
    nextLineIndex: 30
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uB098\uB294 \uADF8\uB7F0 \uC5B4\uC0C9\uD55C \uD658\uB300\uB97C \uBC1B\uC73C\uBA70
      \uC6B0\uC8FC\uC120\uC5D0 \uD0D1\uC2B5\uD588\uB2E4."
    choices: []
    nextLineIndex: 31
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uCD9C\uBC1C\uD55C\uB2E4\uB294 \uC18C\uB9AC\uC640 \uD568\uAED8, \uB2E4\uB978
      \uACF3\uC73C\uB85C \uBE68\uB824\uB098\uAC07\uB4EF \uC6B0\uC8FC\uC120\uC740
      \uB0A0\uB77C\uAC14\uACE0, \uC7A0\uC2DC \uB4A4 \uADF8\uB9AC\uC6B4 \uD48D\uACBD\uC774
      \uBCF4\uC600\uB2E4."
    choices: []
    nextLineIndex: 32
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC9D1\uC774\uB2E4. \uC9C0\uAE08\uAE4C\uC9C0 \uB9CE\uC740 \uC77C\uC774
      \uC788\uC5C8\uB2E4. \uADF8\uB9AC\uACE0, \uB0B4\uAC00 \uC9D1\uC73C\uB85C \uB3CC\uC544\uC624\uBA70
      \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C\uB3C4 \uB9CE\uC740 \uC77C\uC774
      \uC0DD\uAE38 \uAC83\uC774\uB2E4."
    choices: []
    nextLineIndex: 33
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\"\uCC29\uB959\uC9C0 \uC124\uC815 \uC644\uB8CC! \uD589\uC131 \uADA4\uB3C4
      \uC548\uC73C\uB85C \uC811\uADFC\uD569\uB2C8\uB2E4!\""
    choices: []
    nextLineIndex: -1
