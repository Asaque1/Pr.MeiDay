  - speakerFace: {fileID: 0}
    speakerName: 
    text: '                                 '
    choices: []
    nextLineIndex: 2
  - speakerFace: {fileID: 0}
    speakerName: "\uD5EC\uB80C"
    text: "\uBB50\uD574? \uC77C \uB05D\uB0AC\uC796\uC544. \uC548 \uB4E4\uC5B4\uAC00?
      \uC544\uBB34 \uC77C \uC5C6\uB294 \uAC70 \uB9DE\uC544?"
    choices:
    - choiceText: "(\uB300\uCDA9 \uC5BC\uBC84\uBB34\uB9AC\uACE0 \uB5A0\uB09C\uB2E4.)"
      nextLineIndex: 3
      eventId: 0
      eventValue: 0
    nextLineIndex: 1
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uC778\uC801\uC774 \uB4DC\uBB38 \uAD6C\uB3C4\uC2EC\uC744 \uB530\uB77C
      \uC88C\uD45C\uB85C \uD5A5\uD55C\uB2E4. \uB9C8\uCE68\uB0B4 \uC815\uD655\uD788
      \uADF8 \uC88C\uD45C\uC5D0 \uB2E4\uB2E4\uB974\uC790 \uB4A4\uC5D0\uC11C \uB204\uAD70\uAC00
      \uB9D0\uC744 \uAC74\uB2E4."
    choices: []
    nextLineIndex: 4
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: ???
    text: "\uC608\uC0C1 \uC2DC\uAC04\uB300\uB85C \uC654\uAD70. \uB2E4\uB978 \uC0AC\uB78C\uB3C4
      \uB370\uB824\uC624\uC9C0 \uC54A\uACE0."
    choices:
    - choiceText: "\uB2F9\uC2E0. \uB204\uAD6C\uC8E0?"
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    - choiceText: "\uB2F9\uC2E0. \uC6D0\uD558\uB294\uAC8C \uBB50\uC8E0?"
      nextLineIndex: 5
      eventId: 0
      eventValue: 0
    nextLineIndex: 0
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: ???
    text: "\uC544\uC9C1 \uB108\uAC00 \uC54C \uD544\uC694\uB294 \uC5C6\uC5B4. \uB108\uAC00
      \uC54C\uC544\uB3C4 \uB418\uB294 \uAC74 \uD558\uB098\uC57C."
    choices: []
    nextLineIndex: 6
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: ???
    text: "\uB098\uB294 \uB108\uAC00 \uC778\uAC04\uC774\uB77C\uB294 \uAC78 \uC54C\uC544.
      \uC5B4\uB514\uC11C \uB3C4\uB9DD\uCCD0\uC654\uACE0, \uC5B4\uB5BB\uAC8C \uC0B4\uACE0
      \uC788\uB294\uC9C0\uB3C4 \uC54C\uC9C0."
    choices: []
    nextLineIndex: 7
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: ???
    text: "\uB108\uAC00 \uCDA9\uBD84\uD55C \uAC00\uACA9\uB9CC \uB0B8\uB2E4\uBA74,
      \uB108\uC758 \uC815\uCCB4\uB97C \uC228\uACA8\uC8FC\uC9C0."
    choices:
    - choiceText: "\uC54C\uACA0\uC5B4\uC694.."
      nextLineIndex: 8
      eventId: 0
      eventValue: 0
    - choiceText: "\uC5B4\uB5A4\uAC78 \uD574\uC57C \uD558\uC8E0?"
      nextLineIndex: 9
      eventId: 0
      eventValue: 0
    nextLineIndex: 8
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: ???
    text: "\uC88B\uC544. \uADF8\uB7EC\uBA74 \uB098\uC911\uC5D0 \uBCF4\uC9C0."
    choices: []
    nextLineIndex: 10
  - speakerFace: {fileID: 5396913674957190600, guid: a5de98c3e4888ed4ab620b07e9ea75be, type: 3}
    speakerName: ???
    text: "\uAC04\uB2E8\uD574. \uB09C \uB108\uB97C \uBCF4\uD638\uD558\uACE0, \uB10C
      \uB300\uAC00\uB97C \uB0B4\uACE0."
    choices:
    - choiceText: "\uC54C\uACA0\uC5B4\uC694.."
      nextLineIndex: 8
      eventId: 0
      eventValue: 0
    nextLineIndex: 8
  - speakerFace: {fileID: 0}
    speakerName: 
    text: "\uADF8\uB294 \uAC74\uBB3C \uC0AC\uC774 \uC881\uC740 \uACE8\uBAA9\uC73C\uB85C
      \uC0AC\uB77C\uC84C\uB2E4."
    choices: []
    nextLineIndex: -1
