--- !u!114 &589244596
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 589244594}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 50edd690e0cdf9048899057ce8c214ad, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ManualView
  pages:
  - title: "\uBBFC\uC6D0 \uBC1B\uAE30"
    body: "\uC678\uACC4\uC778\uC774 \uCC3D\uAD6C\uC5D0 \uC640\uC11C \uBBFC\uC6D0\uC744
      \uB9D0\uD55C\uB2E4.\n\uB9D0\uC774 \uB05D\uB098\uBA74 \uC544\uB798\uC5D0 \uB2E8\uC5B4
      \uCE74\uB4DC\uAC00 \uB098\uC628\uB2E4."
    image: {fileID: 0}
  - title: "\uC678\uACC4\uC5B4 \uD574\uC11D"
    body: "\uCE74\uB4DC\uB97C \uB300\uC0AC\uC758 \uBE48\uCE78\uC5D0 \uB04C\uC5B4\uB2E4
      \uB193\uB294\uB2E4.\n\uBE48\uCE78\uC744 \uB2E4 \uCC44\uC6B0\uBA74 \uD574\uC11D
      \uD655\uC778 \uBC84\uD2BC\uC774 \uB098\uC628\uB2E4.\n\uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uB9DE\uC558\uB294\uC9C0 \uD655\uC778\uB41C\uB2E4.\n\uD2C0\uB9AC\uBA74 \uC758\uC2EC\uB3C4\uAC00
      \uC624\uB978\uB2E4."
    image: {fileID: 0}
  - title: "\uBBFC\uC6D0 \uCC98\uB9AC"
    body: "\uD574\uC11D\uC774 \uB9DE\uC73C\uBA74 PDA \uD0ED\uC774 \uC5F4\uB9B0\uB2E4.\n\uC11C\uB958
      \uBC1C\uAE09\uC744 \uB204\uB974\uACE0 \uB0B4\uC6A9\uC744 \uD655\uC778\uD55C\uB2E4.\n\uBB38\uC11C
      \uC811\uC218\uB97C \uB204\uB974\uBA74 \uBBFC\uC6D0 \uD558\uB098\uAC00 \uB05D\uB09C\uB2E4."
    image: {fileID: 0}
  - title: "\uD558\uB8E8 \uACB0\uC0B0"
    body: "\uBBFC\uC6D0\uC744 \uB2E4 \uCC98\uB9AC\uD558\uBA74 \uACB0\uC0B0 \uB178\uD2B8\uAC00
      \uB098\uC628\uB2E4.\n\uC624\uB298 \uC218\uC785\uACFC \uC9C0\uCD9C\uC744 \uD655\uC778\uD558\uACE0
      \uB0B4\uC77C\uB85C \uB118\uC5B4\uAC04\uB2E4.\n\uC6D4\uC138\uB294 3\uC77C\uC9F8\uC5D0
      \uCC98\uC74C \uB098\uC624\uACE0 \uADF8 \uB4A4\uB85C 6\uC77C\uB9C8\uB2E4 \uB3CC\uC544\uC628\uB2E4.\n\uBABB
      \uB0B4\uBA74 \uD06C\uB808\uB527\uC774 \uAE4E\uC774\uB294 \uB300\uC2E0 \uCCB4\uBD88\uC774
      \uC313\uC774\uACE0, \uC138 \uBC88 \uBC00\uB9AC\uBA74 \uCAD3\uACA8\uB09C\uB2E4."
    image: {fileID: 0}
  - title: "\uBC24 - \uC0C1\uC810\uACFC \uC54C\uBC14"
    body: "\uC0C1\uC810\uC774 \uC5F4\uB9AC\uBA74 \uBC24\uC5D0 \uBB3C\uAC74\uC744
      \uC0AC\uACE0 \uC54C\uBC14\uB97C \uD560 \uC218 \uC788\uB2E4.\n\uC0C1\uC810\uC740
      \uC11C\uC810\xB7\uC5F0\uADF9\uB2E8\xB7\uD30C\uD2F0\uC6A9\uD488\uC810\xB7\uBE0C\uB85C\uCEE4
      \uB124 \uACF3\uC774\uACE0 \uC704 \uD0ED\uC73C\uB85C \uC62E\uAE34\uB2E4.\n\uBB3C\uAC74
      \uCE78\uC744 \uB204\uB974\uBA74 \uD6A8\uACFC\uC640 \uAC12\uC744 \uBA3C\uC800
      \uBCFC \uC218 \uC788\uB2E4.\n\uC54C\uBC14\uB294 \uC218\uD589\uB960\uC774 \uB192\uC744\uC218\uB85D
      \uD06C\uB808\uB527\uC744 \uB354 \uC900\uB2E4. \uB0A8\uC740 \uD69F\uC218\uB294
      \uB2E4\uC74C \uB0A0\uB85C \uC870\uAE08 \uB118\uC5B4\uAC04\uB2E4."
    image: {fileID: 0}
  titleText: {fileID: 1240667533}
  bodyText: {fileID: 1979646342}
  pageImage: {fileID: 1478725796}
  pageLabel: {fileID: 395785955}
  prevButton: {fileID: 518281868}
  nextButton: {fileID: 1886106457}
